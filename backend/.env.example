# ─── DATABASE ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wmhs_db
DB_USER=wmhs_user
DB_PASSWORD=your_strong_db_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_byte_random_hex_string
JWT_EXPIRES_IN=7d

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# In production set this to your actual frontend URL
FRONTEND_URL=http://localhost:3000

# ─── FILE UPLOADS ─────────────────────────────────────────────────────────────
# 'local' stores files in backend/uploads/ folder (good for development)
# 'cloudinary' uses Cloudinary (recommended for production)
STORAGE_MODE=local
MAX_FILE_SIZE_MB=10

# Cloudinary (only needed if STORAGE_MODE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=wmhs_uploads

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
