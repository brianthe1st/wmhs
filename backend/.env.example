# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Either a single URL (Render gives this) …
# DATABASE_URL=postgres://user:pass@host:5432/wmhs_db
# … or the separate parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wmhs_db
DB_USER=wmhs_user
DB_PASSWORD=change_me
# false = no TLS (local) | strict = verify certificate | (unset) = TLS without verification in production
DB_SSL=false
DB_POOL_MAX=10

# ─── AUTH (required) ──────────────────────────────────────────────────────────
# REQUIRED, at least 32 chars. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
# First admin, created only if no admin exists. Leave ADMIN_PASSWORD empty to get a random one printed once in the logs.
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=
# Graduated students keep read-only access to their results for this many months
GRADUATE_ACCESS_MONTHS=12

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Number of reverse proxies in front (Render = 1)
TRUST_PROXY=1
# Comma-separated list of allowed browser origins (not needed when frontend is served by this server)
FRONTEND_URL=http://localhost:3000

# ─── FILE UPLOADS ─────────────────────────────────────────────────────────────
# local = files on disk under UPLOAD_DIR (needs a persistent disk in production!) | cloudinary
STORAGE_MODE=local
UPLOAD_DIR=
MAX_FILE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── RATE LIMITS (a whole school can share one IP, so these are generous) ────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=3000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_MAX=300
